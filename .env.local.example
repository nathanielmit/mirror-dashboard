# Phase 2 voice assistant config. Copy to .env.local to override defaults.
# The voice route uses the authenticated `claude` CLI — no API key required.

# Set to 0 to disable the LLM entirely (falls back to simple keyword answers).
MIRROR_VOICE_LLM=1

# Model alias (e.g. "haiku", "sonnet") or a full model id. Default: haiku.
MIRROR_LLM_MODEL=haiku

# Path to the claude binary. Auto-detected at ~/.local/bin/claude, then PATH.
# CLAUDE_BIN=/home/nathaniel/.local/bin/claude

# --- Spotify -----------------------------------------------------------
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add this EXACT redirect URI to it (Spotify no longer accepts
#    http://localhost — the literal loopback IP is the only plain-HTTP form
#    still permitted):  http://127.0.0.1:3000/api/spotify/callback
# 3. Paste the app's Client ID / Secret below and restart mirror-web.
# 4. Visit http://127.0.0.1:3000/api/spotify/auth once to link the account.
# Playback control requires Spotify Premium — free accounts get 403.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Connect device to play on. Must match --name in deploy/mirror-spotify.service.
# MIRROR_SPOTIFY_DEVICE=Mirror

# Google Calendar (Phase 3). Paste your calendar's PRIVATE iCal URL:
#   Google Calendar -> Settings -> <your calendar> -> "Integrate calendar"
#   -> "Secret address in iCal format". Keep it secret (this file is gitignored).
# Leave unset and the Schedule widget + calendar voice answers stay hidden.
# GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
