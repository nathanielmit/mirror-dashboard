// Kiosk resilience — install to /etc/apt/apt.conf.d/52unattended-upgrades-kiosk
// Sorts after 50unattended-upgrades, so these override the defaults.

// Default Allowed-Origins includes the plain "${distro_codename}" pocket, i.e.
// it installs EVERY update, not just security ones. On a kiosk that means
// feature/ABI churn (mesa, chromium, node) landing unattended behind the glass.
// Narrow it to security only. Clear the list first — apt.conf lists append.
#clear Unattended-Upgrade::Allowed-Origins;
Unattended-Upgrade::Allowed-Origins {
	"${distro_id}:${distro_codename}-security";
	"${distro_id}ESMApps:${distro_codename}-apps-security";
	"${distro_id}ESM:${distro_codename}-infra-security";
};

// Never let the upgrader reboot the wall display on its own schedule.
Unattended-Upgrade::Automatic-Reboot "false";

// Don't hold the dpkg lock across a power cut any longer than necessary:
// finish an interrupted upgrade on the next run rather than leaving it half-done.
Unattended-Upgrade::AutoFixInterruptedDpkg "true";

// Snap/kernel packages are the ones whose mid-write power loss hurts most.
// Kernel updates also rewrite /boot and re-run update-grub; do those by hand.
Unattended-Upgrade::Package-Blacklist {
	"linux-image-.*";
	"linux-headers-.*";
	"linux-generic.*";
	"grub-.*";
};

// Keep the download step from being its own surprise disk-write burst.
Unattended-Upgrade::MinimalSteps "true";
